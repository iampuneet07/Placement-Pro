# PlacementPro Backend Environment Variables (Sample Template)
# Copy this file to .env and adjust variables as needed

PORT=5000

# Local MongoDB default (ensure MongoDB service is running)
MONGODB_URI=mongodb://127.0.0.1:27017/placementpro

# Or MongoDB Atlas Connection String:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/placementpro?retryWrites=true&w=majority

# Frontend URL for CORS configuration
CLIENT_URL=http://localhost:5173

NODE_ENV=development
